{
  "name": "agent-framework-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "new": "create-curb.js",
    "dev": "npm run dev --workspace examples/insurance-agent",
    "check": "npm run check --workspace examples/insurance-agent",
    "test": "npm test --workspace packages/framework --workspace packages/create-curb.js && node --test \"scripts/*.test.mjs\"",
    "build": "npm run build --workspace packages/framework",
    "smoke:self-host": "node scripts/self-host-smoke.mjs",
    "check:independence": "node scripts/check-independence.mjs",
    "check:examples": "node scripts/check-projects.mjs examples",
    "check:compat": "node scripts/check-projects.mjs compat/projects",
    "server": "cd examples/insurance-agent && curb server",
    "conversations": "cd examples/insurance-agent && curb conversations"
  },
  "overrides": {
    "@livekit/agents-plugin-silero": {
      "onnxruntime-node": "^1.30.0"
    },
    "glob": "^14.0.2",
    "minimatch": "^11.0.2"
  },
  "allowScripts": {
    "esbuild": true,
    "onnxruntime-node": true,
    "@livekit/local-inference": true,
    "protobufjs": true,
    "fsevents": true,
    "sharp": true
  },
  "license": "Apache-2.0"
}
