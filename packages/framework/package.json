{
  "name": "curb",
  "version": "1.0.0",
  "private": true,
  "description": "Voice agents your coding agent can build and improve. Describe the agent you want. Your coding agent builds it, talks to it, and improves it. Run it on your own servers, or let KugelAudio host it.",
  "keywords": [
    "curb",
    "voice-agent",
    "voice-ai",
    "ai-agent",
    "agent-framework",
    "conversational-ai",
    "react",
    "typescript",
    "livekit",
    "llm",
    "mcp",
    "speech-to-text",
    "text-to-speech",
    "telephony"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "KugelAudio GmbH",
    "url": "https://kugelaudio.com"
  },
  "homepage": "https://curbjs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kugelaudio/curb.js.git",
    "directory": "packages/framework"
  },
  "bugs": {
    "url": "https://curbjs.com/docs/reporting-a-bug/"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "curb": "./bin/curb.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./orchestration": "./src/orchestration.ts",
    "./providers": "./src/providers.ts",
    "./client": "./src/client/index.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./orchestration": {
        "types": "./dist/types/orchestration.d.ts",
        "default": "./dist/orchestration.js"
      },
      "./providers": {
        "types": "./dist/types/providers.d.ts",
        "default": "./dist/providers.js"
      },
      "./client": {
        "types": "./dist/types/client/index.d.ts",
        "default": "./dist/client.js"
      },
      "./testing": {
        "types": "./dist/types/testing/index.d.ts",
        "default": "./dist/testing.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "server": "node --env-file-if-exists=.env --import tsx src/server/standalone.ts",
    "bridge": "node --env-file-if-exists=.env --import tsx src/server/bridge-main.ts",
    "build:dist": "node --import tsx scripts/build-dist.ts",
    "prepack": "npm run build:dist"
  },
  "dependencies": {
    "@livekit/agents": "1.10.1",
    "@livekit/agents-plugin-silero": "1.10.1",
    "@livekit/rtc-node": "1.2.3",
    "@opentelemetry/api": "1.10.0",
    "@types/node": "25.9.9",
    "esbuild": "0.28.2",
    "livekit-server-sdk": "2.20.1",
    "onnxruntime-node": "1.31.1",
    "react-reconciler": "0.34.0",
    "tsx": "4.23.15",
    "undici": "7.30.1",
    "ws": "8.23.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "livekit-client": "^2.23.0"
  },
  "peerDependenciesMeta": {
    "livekit-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.107",
    "@ai-sdk/openai": "4.0.122",
    "@ai-sdk/openai-compatible": "3.0.94",
    "@babel/parser": "8.1.3",
    "@base-ui/react": "1.9.0",
    "@dagrejs/dagre": "3.1.3",
    "@fontsource-variable/inter": "5.3.0",
    "@livekit/agents-plugin-cartesia": "^1.10.1",
    "@livekit/agents-plugin-deepgram": "^1.10.1",
    "@livekit/agents-plugin-elevenlabs": "^1.10.1",
    "@livekit/agents-plugin-openai": "^1.10.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-reconciler": "0.34.1",
    "@types/semver": "7.8.0",
    "@types/ws": "^8.18.2",
    "@vercel/nft": "1.11.11",
    "@vitejs/plugin-react": "5.2.0",
    "@xyflow/react": "12.12.1",
    "ai": "7.0.179",
    "buffer": "^6.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild-wasm": "0.28.2",
    "events": "^3.3.0",
    "https-proxy-agent": "7.0.6",
    "livekit-client": "2.25.0",
    "lucide-react": "1.77.0",
    "microsoft-cognitiveservices-speech-sdk": "1.53.0",
    "onnxruntime-web": "^1.31.1",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "readable-stream": "^4.8.0",
    "semver": "7.8.6",
    "shadcn": "4.23.0",
    "streamdown": "2.8.0",
    "string_decoder": "^1.3.0",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.3",
    "util": "^0.12.5",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  }
}
