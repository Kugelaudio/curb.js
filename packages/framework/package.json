{
  "name": "curb",
  "version": "1.0.0",
  "private": true,
  "description": "curb.js — React framework for authoring voice-first LLM agents: agents are React trees compiled into model context and tools, with a browser preview and a WebSocket agent server.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "curb": "./bin/curb.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./orchestration": "./src/orchestration.ts",
    "./providers": "./src/providers.ts",
    "./client": "./src/client/index.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "docs",
    "src",
    "index.html",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "server": "node --env-file-if-exists=.env --import tsx src/server/standalone.ts",
    "bridge": "node --env-file-if-exists=.env --import tsx src/server/bridge-main.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.85",
    "@ai-sdk/openai": "^3.0.84",
    "@ai-sdk/openai-compatible": "^2.0.59",
    "@babel/parser": "^7.29.7",
    "@base-ui/react": "^1.6.0",
    "@dagrejs/dagre": "^3.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@livekit/agents": "^1.9.3",
    "@livekit/agents-plugin-silero": "^1.9.3",
    "@livekit/rtc-node": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^25.9.3",
    "@vercel/nft": "^1.10.2",
    "@vitejs/plugin-react": "^5.1.2",
    "@xyflow/react": "^12.11.2",
    "ai": "^6.0.208",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "https-proxy-agent": "^7.0.6",
    "livekit-client": "^2.20.1",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^1.23.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.50.0",
    "onnxruntime-node": "^1.30.0",
    "react-reconciler": "^0.33.0",
    "shadcn": "^4.12.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@livekit/agents-plugin-cartesia": "^1.9.3",
    "@livekit/agents-plugin-deepgram": "^1.9.3",
    "@livekit/agents-plugin-elevenlabs": "^1.9.3",
    "@livekit/agents-plugin-openai": "^1.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-reconciler": "^0.33.0",
    "@types/semver": "7.8.0",
    "@types/ws": "^8.18.1",
    "buffer": "^6.0.3",
    "esbuild-wasm": "0.28.2",
    "events": "^3.3.0",
    "onnxruntime-web": "^1.30.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "readable-stream": "^4.8.0",
    "semver": "7.8.5",
    "string_decoder": "^1.3.0",
    "typescript": "^6.0.3",
    "util": "^0.12.5",
    "vitest": "^4.1.11"
  }
}
