# Copy to `.env` (gitignored) and fill in the keys you need.
# `npm run server` / `npm run bridge` load this file automatically when present;
# nothing crashes when it is missing — features just report "unavailable".
#
# Keys only: which providers run (LLM, speech-to-text, text-to-speech, voice) is
# authored as <Agent llm stt tts> props in src/agent/agent.tsx (see "curb/providers").

# ── Brain and voice: KugelAudio (required for any agent replies) ───────────
# The agent sets no `llm`, so it runs on kugelaudio.llm(), KugelAudio's EU-hosted LLM;
# the same key speaks its replies (kugelaudio.tts()).
KUGELAUDIO_API_KEY=
# KUGELAUDIO_API_BASE=https://api.eu.kugelaudio.com
# Which agent under src/agents/ boots by default (folder name).
# Default: the first folder in sorted order.
# AGENT_DEFAULT=insurance

# ── Speech-to-text (voice input; optional) ───────────────
# Azure Speech resource key , used by the voice bridge.
# Unset → voice input disabled, chat still works.
AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus
# AZURE_SPEECH_API_VERSION=2025-10-15
# AZURE_SPEECH_MODEL=mai-transcribe-1.5

# ── Keys for non-default providers (chosen in agent.tsx) ───────────────────
# ANTHROPIC_API_KEY=             # anthropic(model)
# OPENAI_API_KEY=                # openai(model), openai.stt(), openai.tts()
# AGENT_LLM_API_KEY=             # openaiCompatible({ baseURL, model }), optional
# AGENT_LLM_TIMEOUT_MS=60000                     # abort a hung LLM call and answer with a fallback reply
# Voice: non-default providers need their LiveKit plugin installed
# (npm install @livekit/agents-plugin-<provider>)
# DEEPGRAM_API_KEY=
# ELEVEN_API_KEY=                # ElevenLabs — one key covers STT and TTS
# CARTESIA_API_KEY=

# ── Hosts & ports (defaults shown) ─────────────────────────────────────────
# WS_PORT=4000                   # the one shared port (preview + chat + voice)
# WS_HOST=127.0.0.1
# BRIDGE_PORT=8788               # voice bridge (npm run bridge)
# BRIDGE_HOST=127.0.0.1

# ── MCP ─────────────────────────────────────────────────────────────────────
# MCP_AUTH_DIR=.mcp-auth         # OAuth token store
# MCP_SERVERS_FILE=mcp.servers.json  # dashboard-added servers

# ── Browser (Vite; VITE_-prefixed vars are exposed to the client) ──────────
# VITE_WS_URL=ws://127.0.0.1:4000   # only to point the preview at a DIFFERENT server (default: same origin)
# VITE_TEN_WS_URL=ws://127.0.0.1:8766
# VITE_BRIDGE_URL=http://127.0.0.1:8788
