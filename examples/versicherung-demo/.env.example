# Copy to `.env` (gitignored) and restart `npm run dev`. `npx curb login` replaces this file.

# KugelAudio runs the LLM, speech recognition and the voice on this one key.
KUGELAUDIO_API_KEY=

# Voice, language and models are authored in src/agent/agent.tsx; this file holds keys only.

# ── Optional: turn-taking, if the agent interrupts or waits too long ──────
# VOICE_ENDPOINTING_MIN_MS=300     # pause before it starts replying (VAD, not semantic)
# VOICE_ENDPOINTING_MAX_MS=3000    # bound for adaptive endpointing when configured

# ── Optional: a different LLM ─────────────────────────────────────────────
# Chosen in agent.tsx with <Agent llm={openai("gpt-5.2")}>; it then needs:
# OPENAI_API_KEY=
# AGENT_LLM_TIMEOUT_MS=60000   # abort a hung LLM call and answer with a fallback reply
