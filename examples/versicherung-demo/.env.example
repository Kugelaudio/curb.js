# Copy to `.env` (gitignored) and fill in three values. Then restart `npm run dev`.
#
# Without any of this the preview still boots and the TEXT chat works.
# Only the spoken part needs keys.

# ── Brain and voice: required for any reply at all ────────────────────────
# KugelAudio is the default LLM (kugelaudio.llm()), and the same key speaks the
# replies. Without it the agent cannot answer, in text or in voice.
KUGELAUDIO_API_KEY=

# ── Speech-to-text: what the caller says ──────────────────────────────────
# Azure Speech resource. Both lines are required for voice input.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus


# Voice, language and the pronunciation dictionary are authored in
# src/agent/agent.tsx (`<Agent tts={kugelaudio.tts({ ... })}>`); this file holds keys only.

# ── Optional: turn-taking, if the agent interrupts or waits too long ──────
# VOICE_ENDPOINTING_MIN_MS=300     # pause before it starts replying (VAD, not semantic)
# VOICE_ENDPOINTING_MAX_MS=3000    # bound for adaptive endpointing when configured
# (Trailing silence before Azure finalises: azure.stt({ segmentationMs }) in agent.tsx.)

# ── Optional: a different LLM ─────────────────────────────────────────────
# Chosen in agent.tsx with <Agent llm={openai("gpt-5.2")}>; it then needs:
# OPENAI_API_KEY=
# AGENT_LLM_TIMEOUT_MS=60000   # abort a hung LLM call and answer with a fallback reply
