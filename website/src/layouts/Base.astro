---
import '@fontsource-variable/geist/wght.css'
import '@fontsource-variable/geist-mono/wght.css'
import '../styles/site.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

const { title, description, path, markdown } = Astro.props as {
  title: string
  description: string
  path: string
  markdown?: string
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- GitHub Pages sends no custom headers, so frame-ancestors, which a meta tag cannot carry, is lost. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={{ "docs-page": markdown }}>
    <a class="skip" href="#main">Skip to the content</a>
    <Header />
    <slot />
    <Footer />
    <script src="../scripts/site.ts"></script>
    <script src="../scripts/search.ts"></script>
    <dialog class="search" data-search aria-label="Search the docs">
      <input type="search" placeholder="Search the docs" aria-label="Search the docs" autocomplete="off" />
      <ul></ul>
    </dialog>
  </body>
</html>
