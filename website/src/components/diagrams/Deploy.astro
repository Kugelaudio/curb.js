---
// Two halves of the tile's outline, both from its left edge to its right, so the dot can split and meet again.
const trace =
  '<path pathLength="1" d="M0 50V15A15 15 0 0 1 15 0H85A15 15 0 0 1 100 15V50"></path>' +
  '<path pathLength="1" d="M0 50V85A15 15 0 0 0 15 100H85A15 15 0 0 0 100 85V50"></path>'
---

<div class="diagram deploy">
  <i class="deploy-dot d-flow" aria-hidden="true"></i>
  <ol aria-label="From a push to a live agent">
    <li>
      <span class="deploy-tile">
        <svg class="deploy-mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>
        <svg class="deploy-trace" viewBox="0 0 100 100" aria-hidden="true" set:html={trace}></svg>
      </span>
      Push
    </li>
    <li>
      <span class="deploy-tile">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5 20.5 7v10L12 21.5 3.5 17V7z"></path><path d="M3.5 7 12 11.5 20.5 7"></path><path d="M12 11.5v10"></path></svg>
        <svg class="deploy-trace" viewBox="0 0 100 100" aria-hidden="true" set:html={trace}></svg>
      </span>
      Build
    </li>
    <li>
      <span class="deploy-tile">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4.5 12.5 5 5 10-11"></path></svg>
        <svg class="deploy-trace" viewBox="0 0 100 100" aria-hidden="true" set:html={trace}></svg>
      </span>
      Check
    </li>
    <li class="deploy-live">
      <span class="deploy-tile">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle class="deploy-ring" cx="12" cy="12" r="9.5"></circle><circle class="deploy-ring" cx="12" cy="12" r="6"></circle><circle class="deploy-core" cx="12" cy="12" r="2.5"></circle></svg>
        <svg class="deploy-trace" viewBox="0 0 100 100" aria-hidden="true" set:html={trace}></svg>
      </span>
      Live
    </li>
    <li>
      <span class="deploy-tile">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 16.6v3a2 2 0 0 1-2.2 2 18.5 18.5 0 0 1-16.4-16.4A2 2 0 0 1 4.4 3h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.4 11a15 15 0 0 0 4.6 4.6l1.4-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path></svg>
        <svg class="deploy-trace" viewBox="0 0 100 100" aria-hidden="true" set:html={trace}></svg>
      </span>
      Calls
    </li>
  </ol>
</div>
